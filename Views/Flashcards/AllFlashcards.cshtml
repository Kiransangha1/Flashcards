@{
    ViewData["Title"] = "flashcards";
    Layout = "_Empty";
    var folderId = ViewBag.FolderId;
}

<div class="background">
<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow mb-3">
    <div class="container-fluid">
                <a asp-controller="Flashcards" asp-action="NewFlashcard" asp-route-folderId="@folderId" class="btn">Add a flashcard</a>
        <a href="@Url.Action("TakeABreak", "Folder")" class="btn">Break Time</a>
        <h1 class="welcome2">Welcome @Context.Session.GetString("Username")!</h1>
        <a asp-controller="Folder" asp-action="Dashboard" class="btn">Home</a>
        <div class="d-flex justify-content-center align-items-center gap-3">
            <form asp-action="Logout" asp-controller="User" method="post">
                <button class="btn btn-link">Logout</button>
            </form>
        </div>
    </div>
</nav>

<style>
    .background {
        position: absolute;
        top: 0;
        left: 0;
        padding: 30px;
        width: 100%;
        min-height: 100vh;
        background: linear-gradient(to top, #b6cedd 0%, #87CEEB 100%);
        z-index: -1;
    }

    .blurred {
        filter: blur(5px);
    }

    .flashcard {
        display: flex;
        background: white;
        color: black;
        text-shadow: 0px 0px 35px black;
        font-size: x-large;
        border-radius: 10px;
        opacity: 0.6;
    }

    .margin {
        margin-left: 250px;
        margin-right: 250px;
    }

    .button {
        background-color: rgba(0, 0, 0, 0.5);
        border: 0px;
    }

    .stopwatch {
        margin-top: 20px;
        text-align: center;
        display: none;
        top: 100px;
        transform: translateX(0%);
        background-color: white;
        opacity: 0.6;
        color: black;
        padding: 20px;
        margin-bottom: 10px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    }

    #display {
        font-size: 2em;
        margin-bottom: 10px;
    }

    button {
        margin: 5px;
        padding: 10px 15px;
        font-size: 1em;
        cursor: pointer;
    }
    .btn {
        color: white;
        background-color: rgb(63, 166, 207);
    }
    .title {
            font-size: 1.5rem;
            font-weight: bold;
            padding: 10px;
            border-radius: 5px;
            transition: background-color 0.3s;
            display: inline-block;
        }

        .title a {
            text-decoration: none;
            color: inherit;
        }

        .title:hover {
            background-color: grey;
        }

        .title a:hover {
            color: #000;
        }
        .description {
            border-radius: 10px;
            word-break: break-word;
            overflow-wrap: break-word;
            white-space: normal;
        }
</style>

@model List<Flashcard>
<div class="image-container">

    @if (Model.Count == 0)
    {
        <h1>Welcome! No Flashcards Yet</h1>
    }
    else
    {
        <a href="#" class="text" onclick="toggleStopwatch(); return false;">Stopwatch</a>
            <div class="stopwatch" id="stopwatch">
                <h2>Stopwatch</h2>
                <div id="display">00:00:00</div>
                <button class="btn" onclick="startStopwatch()">Start</button>
                <button class="btn" onclick="stopStopwatch()">Stop</button>
                <button class="btn" onclick="resetStopwatch()">Reset</button>
            </div>
        <div style="display: flex; justify-content: space-between;">
            <form id="sortForm" method="get" action="#">
    <label for="sortOptions">Sort By:</label>
    <select id="sortOptions" name="sortOrder" onchange="this.form.submit()">
        <option value="">Select...</option>
        <option value="a-z">A-Z</option>
        <option value="z-a">Z-A</option>
        <option value="newest">Newest</option>
        <option value="oldest">Oldest</option>
    </select>
</form>

            <label>
                <input type="checkbox" id="checkAll" onclick="toggleCheckAll(this)">
                Check All
            </label>
        </div>


        @foreach (Flashcard c in Model)
        {
            <div class="flashcard shadow p-3 mb-2 text-center" data-flashcard-id="@c.FlashcardId">
                <div class="d-flex col-10">
                    <div class="me-7 col-4 title" style="color: #000;">
                        <a asp-route-FlashcardId="@c.FlashcardId" asp-action="EditFlashcard"
                            asp-controller="Flashcards">@c.Title</a>
                    </div>
                    <div class=" description d-flex align-items-center justify-content-center col-7 m-3">
                        <p class="@(c.Blur ? "blurred" : "")" id="description-@c.FlashcardId">@c.Description</p>
                    </div>
                </div>
                <div class="class col-1 d-flex justify-content-center align-items-center">
                    <form asp-route-flashcardId="@c.FlashcardId" asp-action="UpdateBlur" asp-controller="Flashcards"
                        method="Post" class="blur-form">
                        <label>
                            <input type="checkbox" name="Blur" value="true" @(c.Blur ? "checked" : "")
                                onchange="submitBlurForm(this, @c.FlashcardId)" class="individual-check">
                        </label>
                        <input type="hidden" name="Blur" value="false" />
                    </form>
                </div>
                <div class="d-flex justify-content-center align-items-center">
                    <form asp-route-flashcardId="@c.FlashcardId" asp-action="DeleteFlashcard" asp-controller="Flashcards"
                        method="Post">
                        <div class="delete-icon" onclick="this.closest('form').submit();" style="cursor: pointer;">
                            <img src="~/image/delete.png" alt="Delete"
                                style="width: 35px; height: 35px;">
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function deleteFlashcard(event, element) {
        event.preventDefault();

        var form = $(element).closest('form');
        var url = form.attr('action');
        var flashcardId = form.data('flashcard-id');

        $.ajax({
            type: 'POST',
            url: url,
            data: {
    flashcardId: flashcardId,
    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
},
            success: function(response) {
                form.closest('.flashcard-item').remove();
            },
            error: function(xhr, status, error) {
                console.error('Error deleting flashcard:', error);
            }
        });
    }
    function toggleCheckAll(checkbox) {
        const individualChecks = document.querySelectorAll('.individual-check');

        individualChecks.forEach(function (individualCheck) {
            individualCheck.checked = checkbox.checked;
            const flashcardId = individualCheck.closest('.flashcard').dataset.flashcardId;
            const descriptionElement = $('#description-' + flashcardId);
            if (checkbox.checked) {
                descriptionElement.addClass('blurred');
            } else {
                descriptionElement.removeClass('blurred');
            }
        });
    }

    document.querySelectorAll('.individual-check').forEach(function (individualCheck) {
        individualCheck.addEventListener('change', function () {
            const allChecked = [...document.querySelectorAll('.individual-check')].every(check => check.checked);
            document.getElementById('checkAll').checked = allChecked;
        });
    });

    function submitBlurForm(checkbox, flashcardId) {
        const form = checkbox.closest('form');
        const formData = new FormData(form);

        const descriptionElement = $('#description-' + flashcardId);
        if (checkbox.checked) {
            descriptionElement.addClass('blurred');
        } else {
            descriptionElement.removeClass('blurred');
        }

        $.ajax({
            type: form.method,
            url: form.action,
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                console.log('Blur updated successfully');
            },
            error: function (xhr, status, error) {
                console.error('Error updating blur:', error);
            }
        });
    }

        let stopwatchInterval;
        let seconds = 0;

        function sortAndSubmit(event) {
        event.preventDefault();

        const selectedValue = event.target.value;
        const flashcardsContainer = document.querySelector('.image-container');
        const flashcards = Array.from(flashcardsContainer.querySelectorAll('.flashcard'));

        flashcards.sort((a, b) => {
            const titleA = a.dataset.title.toLowerCase();
            const titleB = b.dataset.title.toLowerCase();
            const dateA = new Date(a.dataset.createdDate);
            const dateB = new Date(b.dataset.createdDate);

            switch (selectedValue) {
                case 'az':
                    return titleA.localeCompare(titleB);
                case 'za':
                    return titleB.localeCompare(titleA);
                case 'newest':
                    return dateB - dateA;
                case 'oldest':
                    return dateA - dateB;
                default:
                    return 0;
            }
        });

        flashcardsContainer.innerHTML = '';

        flashcards.forEach(flashcard => {
            flashcardsContainer.appendChild(flashcard);
        }); 
        updateDisplay();
    }

    function updateDisplay() {
        const display = document.getElementById('display');
        const hours = Math.floor(seconds / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);
        const secs = seconds % 60;

        display.innerText = 
            String(hours).padStart(2, '0') + ':' +
            String(minutes).padStart(2, '0') + ':' +
            String(secs).padStart(2, '0');
    }

    function startStopwatch() {
        if (!stopwatchInterval) {
            stopwatchInterval = setInterval(() => {
                seconds++;
                updateDisplay();
            }, 1000);
        }
    }

    function stopStopwatch() {
        clearInterval(stopwatchInterval);
        stopwatchInterval = null;
    }

    function resetStopwatch() {
        stopStopwatch();
        seconds = 0;
        updateDisplay();
    }
    function toggleStopwatch() {
        const stopwatch = document.getElementById('stopwatch');
        stopwatch.style.display = stopwatch.style.display === 'none' ? 'block' : 'none';
    }
</script>
</div>