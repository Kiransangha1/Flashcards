@{
    ViewData["Title"] = "folder";
    Layout = "_Empty";
}
<link rel="stylesheet" href="~/css/wave.css">

<div class="background"> 
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow mb-3">
        <div class="container-fluid">
            <a asp-controller="Folder" asp-action="Dashboard" class="btn">Home</a>
            <div class="d-flex justify-content-center align-items-center gap-3">
                <form asp-action="Logout" asp-controller="User" method="post">
                    <button class="btn btn-link">Logout</button>
                </form>
            </div>
        </div>
    </nav>

    @model Folder
<div class="folderbox">

    <h1>Add Folder</h1>

    <form asp-action="CreateFolder" asp-controller="Folder" method="Post">
        <div class="my-3">
            <label asp-for="FolderName">Folder Name</label>
            <input asp-for="FolderName" />
            <span class="text-danger" asp-validation-for="FolderName"></span>
        </div>
        <button class="btn">Create Folder</button>
    </form>
</div>

    <div class="wave-container">
        <svg class="wave wave1" viewBox="0 0 1440 320" preserveAspectRatio="none">
            <path
                d="M0,96L48,128C96,160,192,224,288,229.3C384,235,480,181,576,176C672,171,768,213,864,208C960,203,1056,149,1152,117.3C1248,85,1344,75,1392,69.3L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z">
